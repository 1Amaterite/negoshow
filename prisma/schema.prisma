generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


enum BulletinStatus {
  PENDING
  PENDING_VALIDATION
  VALIDATED
  PROCESSED
  REQUIRES_MANUAL_REVIEW
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Commodity {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  imageUrl    String?

  retailPrices RetailPrice[]
  vendorChecks VendorCheck[]
}

model Market {
  id   Int    @id @default(autoincrement())
  name String

  vendorChecks VendorCheck[]
  retailPrices RetailPrice[]
}

model RetailPrice {
  id               Int      @id @default(autoincrement())
  commodityId      Int
  marketId         Int?     @default(1)
  price            Float
  observedDate     DateTime
  sourceBulletinId Int?
  isProxy          Boolean  @default(false)
  isVerified       Boolean  @default(false)
  confidenceScore  Float?
  isFlagged        Boolean  @default(false)
  flagReason       String?
  validationStatus String   @default("pending")
  createdAt        DateTime @default(now())

  commodity      Commodity       @relation(fields: [commodityId], references: [id])
  market         Market?         @relation(fields: [marketId], references: [id])
  sourceBulletin BulletinRecord? @relation(fields: [sourceBulletinId], references: [id], onDelete: Cascade)

  @@index([commodityId, observedDate])
  @@index([isVerified, observedDate(sort: Desc)])
}

model VendorCheck {
  id               Int                  @id @default(autoincrement())
  commodityId      Int
  marketId         Int?
  checkedPrice     Float
  checkedAt        DateTime             @default(now())
  isFlagged        Boolean              @default(false)
  flagReason       String?
  isVerified       Boolean              @default(false)
  validationStatus String               @default("pending")

  commodity           Commodity            @relation(fields: [commodityId], references: [id])
  market              Market?              @relation(fields: [marketId], references: [id])

  @@index([commodityId, checkedAt])
}

model BulletinRecord {
  id              Int            @id @default(autoincrement())
  fileUrl         String
  uploadDate      DateTime       @default(now())
  processedStatus BulletinStatus @default(PENDING)
  sourceOffice    String?
  bulletinDate    DateTime?
  docType         String?
  commodities     String[]

  retailPrices RetailPrice[]
}


model AdminAlert {
  id        Int      @id @default(autoincrement())
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
